{
  "color": {
    "light": {
      "bg": { "$type": "color", "$value": "#FBFBFD" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "surface-2": { "$type": "color", "$value": "#F3F3F7" },
      "text": { "$type": "color", "$value": "#16161D" },
      "muted": { "$type": "color", "$value": "#6B6B78" },
      "line": { "$type": "color", "$value": "#E6E6EC" },
      "accent": { "$type": "color", "$value": "#5B57F5" },
      "on-accent": { "$type": "color", "$value": "#FFFFFF" },
      "success": { "$type": "color", "$value": "#22A35B" },
      "warning": { "$type": "color", "$value": "#F5A524" },
      "danger": { "$type": "color", "$value": "#E5484D" },
      "highlight": { "$type": "color", "$value": "#FFE58A" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "#0E0E13" },
      "surface": { "$type": "color", "$value": "#17171F" },
      "surface-2": { "$type": "color", "$value": "#20202B" },
      "text": { "$type": "color", "$value": "#EDEDF2" },
      "muted": { "$type": "color", "$value": "#8B8B9A" },
      "line": { "$type": "color", "$value": "#2A2A36" },
      "accent": { "$type": "color", "$value": "#7C78FF" },
      "on-accent": { "$type": "color", "$value": "#0E0E13" },
      "success": { "$type": "color", "$value": "#3CCF7B" },
      "warning": { "$type": "color", "$value": "#F7B955" },
      "danger": { "$type": "color", "$value": "#FF6B6B" }
    },
    "category": {
      "green": { "$type": "color", "$value": "#22A35B" },
      "blue": { "$type": "color", "$value": "#3B82F6" },
      "orange": { "$type": "color", "$value": "#F47D31" },
      "pink": { "$type": "color", "$value": "#E85AAD" },
      "teal": { "$type": "color", "$value": "#14B8A6" },
      "yellow": { "$type": "color", "$value": "#F0BF00" }
    }
  },
  "font": {
    "family": {
      "body": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "sans-serif"] },
      "display": { "$type": "fontFamily", "$value": ["Figtree", "Inter", "ui-sans-serif", "sans-serif"] },
      "reading": { "$type": "fontFamily", "$value": ["Newsreader", "Source Serif 4", "Georgia", "serif"] },
      "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "24px" },
      "2xl": { "$type": "dimension", "$value": "32px" },
      "3xl": { "$type": "dimension", "$value": "48px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "line-height": {
    "tight": { "$type": "number", "$value": 1.25 },
    "body": { "$type": "number", "$value": 1.5 },
    "reading": { "$type": "number", "$value": 1.65 }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "7": { "$type": "dimension", "$value": "32px" },
    "8": { "$type": "dimension", "$value": "48px" },
    "9": { "$type": "dimension", "$value": "64px" },
    "10": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": [
      { "color": "#16161D0F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      { "color": "#16161D14", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" } ] },
    "md": { "$type": "shadow", "$value": { "color": "#16161D14", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } },
    "lg": { "$type": "shadow", "$value": [
      { "color": "#16161D40", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-12px" },
      { "color": "#16161D14", "offsetX": "0px", "offsetY": "8px", "blur": "16px", "spread": "0px" } ] }
  },
  "border": {
    "width": {
      "hairline": { "$type": "dimension", "$value": "1px" },
      "focus": { "$type": "dimension", "$value": "3px" }
    }
  },
  "control": {
    "height": {
      "compact": { "$type": "dimension", "$value": "28px" },
      "desktop": { "$type": "dimension", "$value": "36px" },
      "mobile": { "$type": "dimension", "$value": "44px" },
      "cta": { "$type": "dimension", "$value": "52px" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" },
      "celebrate": { "$type": "duration", "$value": "600ms" }
    },
    "easing": {
      "enter": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    }
  }
}
