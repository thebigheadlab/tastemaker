            "source": "votes",
            "basis": "typeScale=moderate"
          }
        }
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      }
    },
    "ratio": {
      "$type": "number",
      "$value": 1.2,
      "$extensions": {
        "tastemaker": {
          "source": "votes",
          "basis": "typeScale=moderate"
        }
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.5,
        "$extensions": {
          "tastemaker": {
            "source": "votes",
            "basis": "density=comfortable"
          }
        }
      }
    }
  },
