{
  "$description": "Design tokens in the W3C Design Tokens format. Shadows are CSS strings. Each token's source is 'votes' (a curated preset picked by your votes) or 'default' (curated, not decided by votes).",
  "$extensions": {
    "tastemaker": {
      "generator": {
        "name": "tastemaker-generator",
        "version": "1.0.0"
      },
      "deck": {
        "version": 2,
        "hash": "0123456789abcdef",
        "cardCount": 8
      },
      "preferredMode": {
        "value": "dark",
        "source": "votes"
      },
      "contrast": {
        "light": {
          "text on bg": 17.89,
          "text on surface": 16.23,
          "muted on bg": 6.82,
          "muted on surface": 6.19,
          "accent on bg": 7.9,
          "on-accent on accent": 7.9,
          "success on bg": 5.02,
          "warning on bg": 7.09,
          "danger on bg": 6.47
        },
        "dark": {
          "text on bg": 15.87,
          "text on surface": 14.41,
          "muted on bg": 7.3,
          "muted on surface": 6.63,
          "accent on bg": 6.87,
          "on-accent on accent": 6.87,
          "success on bg": 10.74,
          "warning on bg": 11.21,
          "danger on bg": 6.76
        }
      }
    }
  },
  "color": {
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#f4f4f1",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "#17171a",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#5a5a63",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "line": {
        "$type": "color",
        "$value": "#d4d4cf",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "success": {
        "$type": "color",
        "$value": "#15803d",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "warning": {
        "$type": "color",
        "$value": "#92400e",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "danger": {
        "$type": "color",
        "$value": "#b91c1c",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#4338ca",
        "$extensions": {
          "tastemaker": {
            "source": "votes",
            "basis": "accentHue=indigo"
          }
        }
      },
      "on-accent": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "tastemaker": {
            "source": "votes",
            "basis": "accentHue=indigo"
          }
        }
      }
    },
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "#121214",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#1c1c20",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "#ececef",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#a1a1aa",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "line": {
        "$type": "color",
        "$value": "#2e2e34",
        "$extensions": {
          "tastemaker": {
