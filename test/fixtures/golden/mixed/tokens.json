            "basis": "curated"
          }
        }
      },
      "success": {
        "$type": "color",
        "$value": "#4ade80",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "warning": {
        "$type": "color",
        "$value": "#fbbf24",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "danger": {
        "$type": "color",
        "$value": "#f87171",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#8b93ff",
        "$extensions": {
          "tastemaker": {
            "source": "votes",
            "basis": "accentHue=indigo"
          }
        }
      },
      "on-accent": {
        "$type": "color",
        "$value": "#121214",
        "$extensions": {
          "tastemaker": {
            "source": "votes",
            "basis": "accentHue=indigo"
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "body": {
        "$type": "fontFamily",
        "$value": "\"Inter\", \"Helvetica Neue\", Arial, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "$extensions": {
          "tastemaker": {
            "source": "votes",
            "basis": "typeStyle=grotesk"
          }
        }
      },
      "display": {
        "$type": "fontFamily",
        "$value": "\"Alpha Sans\", \"Inter\", \"Helvetica Neue\", Arial, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "$extensions": {
          "tastemaker": {
            "source": "votes",
            "basis": "font Alpha Sans in 2 loved or liked cards"
          }
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, \"JetBrains Mono\", Menlo, Consolas, monospace",
        "$extensions": {
          "tastemaker": {
            "source": "default",
            "basis": "curated"
          }
        }
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "11px",
        "$extensions": {
          "tastemaker": {
